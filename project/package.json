{
  "name": "devoras-design",
  "private": true,
  "version": "0.9.29",
  "type": "module",
  "engines": {
    "node": ">=22.6",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "tauri:dev": "pnpm tauri dev",
    "tauri:build": "pnpm tauri build",
    "test:t1": "pnpm test:blockkey && pnpm test:path && pnpm test:dirty && pnpm test:closeguard && pnpm test:paneownership && pnpm test:tabstore && pnpm test:activetab && pnpm test:caretstability && pnpm test:symbol && pnpm test:image && pnpm test:ime && pnpm test:sanitizer && pnpm test:diff && pnpm test:structuraltrigger && pnpm test:readvieweorder",
    "test:structuraltrigger": "node --import ./scripts/register-ts.mjs src/shared/lib/editor/__tests__/structural_trigger_coverage_harness.ts",
    "test:readvieweorder": "node --import ./scripts/register-ts.mjs src/entities/document/__tests__/readview_reorder_after_singledoc_edit_harness.ts",
    "test:t15": "pnpm test:formattoolbar && pnpm test:savedirty && pnpm test:tabswitch && pnpm test:fileexplorer && pnpm test:erdparsefailure",
    "test:formattoolbar": "node --import ./scripts/register-dom.mjs src/widgets/BlockEditor/__tests__/format_toolbar_mount_harness.tsx",
    "test:savedirty": "node --import ./scripts/register-dom.mjs src/pages/WorkspacePage/__tests__/save_dirty_indicator_harness.tsx",
    "test:tabswitch": "node --import ./scripts/register-dom.mjs src/pages/WorkspacePage/__tests__/tab_panel_switch_harness.tsx",
    "test:fileexplorer": "node --import ./scripts/register-dom.mjs src/widgets/FileExplorer/__tests__/file_explorer_interaction_harness.tsx",
    "test:erdparsefailure": "node --import ./scripts/register-dom.mjs src/widgets/ErdDesigner/__tests__/erd_parse_failure_no_overwrite_harness.tsx",
    "test:blockkey": "node --import ./scripts/register-ts.mjs src/entities/block/__tests__/block_key_stability_harness.ts",
    "test:paneownership": "node --import ./scripts/register-ts.mjs src/entities/document/__tests__/pane_ownership_harness.ts",
    "test:tabstore": "node --import ./scripts/register-ts.mjs src/entities/document/__tests__/tab_store_isolation_harness.ts",
    "test:activetab": "node --import ./scripts/register-ts.mjs src/entities/document/__tests__/active_tab_resolution_harness.ts",
    "test:caretstability": "node --import ./scripts/register-ts.mjs src/widgets/BlockEditor/__tests__/caret_stability_harness.ts",
    "test:diff": "node --import ./scripts/register-ts.mjs src/shared/lib/editor/__tests__/minimal_diff_harness.ts",
    "test:path": "node --import ./scripts/register-ts.mjs src/shared/lib/__tests__/path_harness.ts",
    "test:dirty": "node --import ./scripts/register-ts.mjs src/entities/document/__tests__/dirty_baseline_harness.ts",
    "test:closeguard": "node --import ./scripts/register-ts.mjs src/entities/document/__tests__/tab_close_guard_harness.ts",
    "test:image": "node --import ./scripts/register-ts.mjs src/shared/lib/fs/__tests__/image_asset_harness.ts",
    "test:symbol": "node --import ./scripts/register-ts.mjs src/shared/lib/markdown/__tests__/custom_symbol_harness.ts",
    "test:ime": "node --import ./scripts/register-ts.mjs src/widgets/BlockEditor/__tests__/ime_isolation_harness.ts",
    "test:sanitizer": "node --import ./scripts/register-ts.mjs src/widgets/BlockEditor/__tests__/sanitizer_harness.ts",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\"",
    "prepare": "cd .. && husky project/.husky"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.6",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@xyflow/react": "^12.11.2",
    "dompurify": "^3.4.14",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.1",
    "lucide-react": "^1.24.0",
    "marked": "^18.0.7",
    "marked-highlight": "^2.2.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/dompurify": "^3.2.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.26",
    "husky": "^8.0.3",
    "jsdom": "^24.1.3",
    "lint-staged": "^15.5.2",
    "postcss": "^8.5.3",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^7.3.6"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "src/**/*.{css,json}": [
      "prettier --write"
    ]
  },
  "_compatibility_notes": {
    "held_for_major_migration": [
      "react 18→19 (API 변경, 별도 마이그레이션 필요)",
      "tailwindcss 3→4 (설정 파일 구조 전면 개편 필요)",
      "eslint 8→9/10 (flat config 형식으로 전환 필요, @typescript-eslint v8 연동)",
      "zustand 4→5 (일부 API 변경)",
      "typescript 5→7 (안정성 검증 필요)",
      "husky 8→9 (prepare 스크립트 형식 변경)",
      "@vitejs/plugin-react 4→6 (Vite 8 OXC 파이프라인 완전 호환은 plugin-react-oxc로 전환 권장)"
    ]
  }
}
