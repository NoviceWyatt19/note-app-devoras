{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Devoras default capability set — grants file system and dialog access",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-home-read-recursive",
    "fs:allow-home-write-recursive",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-ask",
    "core:window:allow-destroy",
    "core:window:allow-close"
  ]
}
